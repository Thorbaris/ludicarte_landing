---
import Main from '../layouts/main.astro';

import PageHeader from '@/components/ui/PageHeader.vue';
import Team from '@/components/pages/index/Team.vue';
import Features from '@/components/pages/index/Features.vue';
---

<Main
  title="Nosotros — Ludicarte"
  description="Conoce al equipo de Ludicarte: educadores y artistas apasionados por crear experiencias seguras y estimulantes para niños a través del arte y el juego."
  keywords="equipo ludicarte, educadores infantiles, sobre nosotros, after school"
>
  <PageHeader title="Nosotros" scene="equipo">
    <p>
      Ludicarte es un espacio dedicado a fomentar la creatividad y el aprendizaje a través
      de actividades lúdicas y artísticas para niños y niñas. Nuestro equipo combina
      experiencia educativa y pasión por las artes para crear programas seguros y
      estimulantes.
    </p>
  </PageHeader>

  <Team />

  <!-- <Features /> -->
</Main>

