---
import Main from '../layouts/main.astro';

import PageHeader from '@/components/ui/PageHeader.vue';

const jornadas = [
  { nombre: 'Jornada de mañana', horario: '08:00 a 13:00', icono: '☀️', color: 'orange' },
  { nombre: 'Jornada de tarde', horario: '14:00 a 19:00', icono: '🌤️', color: 'blue' },
  { nombre: 'Edades', horario: '4 a 10 años', icono: '🧒', color: 'green' },
];
---

<Main
  title="Horarios y edades — Ludicarte"
  description="Consulta los horarios de mañana (08:00 a 13:00) y tarde (14:00 a 19:00) de Ludicarte AfterSchool, así como las edades recomendadas para cada actividad (4 a 10 años)."
  keywords="horarios after school, edades recomendadas, actividades para niños, ludicarte horarios"
>
  <PageHeader title="Horarios y edades" scene="horarios">
    <p>
      Aquí tienes una guía general de las actividades, sus edades recomendadas y horarios.
      <strong class="text-ink">¡Recibimos niños de 4 a 10 años con ganas de pasarlo bien y aprender!</strong>
    </p>
  </PageHeader>

  <section class="mx-auto max-w-5xl px-4 pb-14 pt-6 sm:px-6 lg:px-8">
    <ul class="grid gap-x-6 gap-y-8 sm:grid-cols-3">
      {jornadas.map((jornada) => (
        <li
          data-solid
          class="block-card p-7 text-center"
          style={`--edge: var(--brand-${jornada.color})`}
        >
          <span class="text-4xl" aria-hidden="true">{jornada.icono}</span>
          <p class="mt-3 text-sm font-bold uppercase tracking-[0.18em] text-ink-soft">{jornada.nombre}</p>
          <p class="mt-2 font-display text-3xl font-semibold">{jornada.horario}</p>
        </li>
      ))}
    </ul>
    <div class="mt-12 text-center">
      <a href="/#contacto" class="btn">Contáctanos</a>
    </div>
  </section>

</Main>
